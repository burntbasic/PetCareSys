# ==================================
# PetCare - Database Configuration
# ==================================
#
# Make a copy of this file and rename it to => database.properties
#
# Enter your local MySQL database details below.
#
# MySQL Database URL (default database: PetCareSysDB)
db.url=jdbc:mysql://localhost:3306/PetCareSysDB

# MySQL username
db.user=your_username

# MySQL password
db.password=your_password