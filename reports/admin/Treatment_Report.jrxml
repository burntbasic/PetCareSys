</field>

<field name="treatment_description" class="java.lang.String">

	<property name="com.jaspersoft.studio.field.name" value="treatment_description"/>

	<property name="com.jaspersoft.studio.field.label" value="treatment_description"/>

</field>

<field name="medication" class="java.lang.String">

	<property name="com.jaspersoft.studio.field.name" value="medication"/>

	<property name="com.jaspersoft.studio.field.label" value="medication"/>

</field>

<field name="status" class="java.lang.String">

	<property name="com.jaspersoft.studio.field.name" value="status"/>

	<property name="com.jaspersoft.studio.field.label" value="status"/>

</field>


