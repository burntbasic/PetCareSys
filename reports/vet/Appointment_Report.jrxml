<?xml version="1.0" encoding="UTF-8"?>

<jasperReport name="Appointment_Report"

              language="java"

              pageWidth="595"

              pageHeight="842"

              columnWidth="555"

              leftMargin="20"

              rightMargin="20"

              topMargin="20"

              bottomMargin="20"

              uuid="b8f3c721-5d42-4a91-9c67-18e4a2f73051">

	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>

	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>

	<parameter name="VET_ID" class="java.lang.Integer"/>

	<query language="SQL"><![CDATA[

SELECT

    p.name AS pet_name,

    CONCAT(o.first_name, ' ', o.last_name) AS owner_name,

    a.appointment_date,

    a.reason,

    a.status

FROM Appointments a

JOIN Pets p ON a.pet_id = p.pet_id

JOIN Users o ON p.owner_id = o.user_id

WHERE a.vet_id = $P{VET_ID}

ORDER BY a.appointment_date DESC

	]]></query>

	<field name="pet_name" class="java.lang.String">

		<property name="com.jaspersoft.studio.field.name" value="pet_name"/>

		<property name="com.jaspersoft.studio.field.label" value="pet_name"/>

	</field>

	<field name="owner_name" class="java.lang.String">

		<property name="com.jaspersoft.studio.field.name" value="owner_name"/>

		<property name="com.jaspersoft.studio.field.label" value="owner_name"/>

	</field>

	<field name="appointment_date" class="java.time.LocalDateTime">

		<property name="com.jaspersoft.studio.field.name" value="appointment_date"/>

		<property name="com.jaspersoft.studio.field.label" value="appointment_date"/>

	</field>

	<field name="reason" class="java.lang.String">

		<property name="com.jaspersoft.studio.field.name" value="reason"/>

		<property name="com.jaspersoft.studio.field.label" value="reason"/>

	</field>

	<field name="status" class="java.lang.String">

		<property name="com.jaspersoft.studio.field.name" value="status"/>

		<property name="com.jaspersoft.studio.field.label" value="status"/>

	</field>


	<background splitType="Stretch"/>


	<title height="90" splitType="Stretch">

		<element kind="staticText"

				 x="0"

				 y="5"

				 width="555"

				 height="35"

				 fontSize="24.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[PetCareSys]]></text>

		</element>

		<element kind="staticText"

				 x="0"

				 y="45"

				 width="555"

				 height="20"

				 fontSize="14.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[Appointment Report]]></text>

		</element>

		<element kind="line"

				 x="0"

				 y="78"

				 width="555"

				 height="1"/>

	</title>


	<pageHeader height="10" splitType="Stretch"/>


	<columnHeader height="35" splitType="Stretch">

		<element kind="staticText"

				 x="0"

				 y="0"

				 width="110"

				 height="35"

				 fontSize="10.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[Pet]]></text>

			<box>

				<pen lineWidth="0.5"/>

			</box>

		</element>


		<element kind="staticText"

				 x="110"

				 y="0"

				 width="130"

				 height="35"

				 fontSize="10.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[Owner]]></text>

			<box>

				<pen lineWidth="0.5"/>

			</box>

		</element>


		<element kind="staticText"

				 x="240"

				 y="0"

				 width="115"

				 height="35"

				 fontSize="10.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[Date]]></text>

			<box>

				<pen lineWidth="0.5"/>

			</box>

		</element>


		<element kind="staticText"

				 x="355"

				 y="0"

				 width="120"

				 height="35"

				 fontSize="10.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[Reason]]></text>

			<box>

				<pen lineWidth="0.5"/>

			</box>

		</element>


		<element kind="staticText"

				 x="475"

				 y="0"

				 width="80"

				 height="35"

				 fontSize="10.0"

				 bold="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[Status]]></text>

			<box>

				<pen lineWidth="0.5"/>

			</box>

		</element>

	</columnHeader>


	<detail>

		<band height="35" splitType="Stretch">

			<element kind="textField"

					 x="0"

					 y="0"

					 width="110"

					 height="35"

					 fontSize="10.0"

					 vTextAlign="Middle">

				<expression><![CDATA[$F{pet_name}]]></expression>

				<box>

					<pen lineWidth="0.5"/>

				</box>

			</element>


			<element kind="textField"

					 x="110"

					 y="0"

					 width="130"

					 height="35"

					 fontSize="10.0"

					 vTextAlign="Middle">

				<expression><![CDATA[$F{owner_name}]]></expression>

				<box>

					<pen lineWidth="0.5"/>

				</box>

			</element>


			<element kind="textField"

					 x="240"

					 y="0"

					 width="115"

					 height="35"

					 fontSize="10.0"

					 hTextAlign="Center"

					 vTextAlign="Middle">

				<expression><![CDATA[$F{appointment_date}.format(java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy, hh:mm a"))]]></expression>

				<box>

					<pen lineWidth="0.5"/>

				</box>

			</element>


			<element kind="textField"

					 x="355"

					 y="0"

					 width="120"

					 height="35"

					 fontSize="10.0"

					 vTextAlign="Middle"

					 blankWhenNull="true"

					 textAdjust="StretchHeight">

				<expression><![CDATA[$F{reason}]]></expression>

				<box>

					<pen lineWidth="0.5"/>

				</box>

			</element>


			<element kind="textField"

					 x="475"

					 y="0"

					 width="80"

					 height="35"

					 fontSize="10.0"

					 hTextAlign="Center"

					 vTextAlign="Middle">

				<expression><![CDATA[$F{status}]]></expression>

				<box>

					<pen lineWidth="0.5"/>

				</box>

			</element>

		</band>

	</detail>


	<columnFooter height="20" splitType="Stretch"/>


	<pageFooter height="35" splitType="Stretch">

		<element kind="line"

				 x="0"

				 y="0"

				 width="555"

				 height="1"/>

		<element kind="staticText"

				 x="0"

				 y="8"

				 width="100"

				 height="20"

				 fontSize="9.0"

				 vTextAlign="Middle">

			<text><![CDATA[PetCareSys]]></text>

		</element>

		<element kind="textField"

				 x="455"

				 y="8"

				 width="100"

				 height="20"

				 fontSize="9.0"

				 hTextAlign="Right"

				 vTextAlign="Middle">

			<expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression>

		</element>

	</pageFooter>


	<summary height="30" splitType="Stretch">

		<element kind="staticText"

				 x="0"

				 y="5"

				 width="555"

				 height="20"

				 fontSize="9.0"

				 italic="true"

				 hTextAlign="Center"

				 vTextAlign="Middle">

			<text><![CDATA[End of Appointment Report]]></text>

		</element>

	</summary>

</jasperReport>
