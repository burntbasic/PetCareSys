<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version last -->
<jasperReport name="Medical_Record_Report"
              language="java"
              pageWidth="842"
              pageHeight="595"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="7f2a8c91-4b35-4e67-ae42-91c6f8e3b521">

	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>

	<parameter name="VET_ID" class="java.lang.Integer"/>

	<query language="SQL"><![CDATA[
SELECT
    p.name AS pet_name,
    CONCAT(o.first_name, ' ', o.last_name) AS owner_name,
    t.diagnosis,
    t.treatment_description,
    t.medication,
    t.treatment_date
FROM Treatments t
JOIN Appointments a ON t.appointment_id = a.appointment_id
JOIN Pets p ON a.pet_id = p.pet_id
JOIN Users o ON p.owner_id = o.user_id
WHERE t.vet_id = $P{VET_ID}
ORDER BY t.treatment_date DESC
]]></query>

	<field name="pet_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="pet_name"/>
		<property name="com.jaspersoft.studio.field.label" value="pet_name"/>
	</field>

	<field name="owner_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="owner_name"/>
		<property name="com.jaspersoft.studio.field.label" value="owner_name"/>
	</field>

	<field name="diagnosis" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="diagnosis"/>
		<property name="com.jaspersoft.studio.field.label" value="diagnosis"/>
	</field>

	<field name="treatment_description" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="treatment_description"/>
