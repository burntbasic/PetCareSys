		<property name="com.jaspersoft.studio.field.label" value="medication"/>
	</field>

	<field name="treatment_date" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="treatment_date"/>
		<property name="com.jaspersoft.studio.field.label" value="treatment_date"/>
	</field>

